@staff_member_required

def report_trial_balance(request):
    Posting, cfg = _posting_model_and_fields()
    dfrom, dto = _date_range(request)
    code_prefix = (request.GET.get("code_prefix") or "").strip()

    base = Posting.objects.filter(**{
        f"{cfg['date']}__gte": dfrom,
        f"{cfg['date']}__lte": dto,
    })
    if code_prefix:
        base = base.filter(**{f"{cfg['account']}__code__startswith": code_prefix})

    agg = (
        base.values("account_id", "account__code", "account__name")
            .annotate(
                deb=_coalesce0(cfg["debit"]),
                cre=_coalesce0(cfg["credit"]),
            )
            .order_by("account__code")
    )
    rows = list(agg)

    total_deb = sum((r["deb"] or Decimal("0")) for r in rows)
    total_cre = sum((r["cre"] or Decimal("0")) for r in rows)
    total_bal = total_deb - total_cre
    balanced = abs(total_bal) < Decimal("0.005")

    # export rows
    xrows = []
    for r in rows:
        deb = r["deb"] or Decimal("0")
        cre = r["cre"] or Decimal("0")
        xrows.append([
            r.get("account__code") or "",
            r.get("account__name") or "",
            f"{deb:.2f}", f"{cre:.2f}", f"{(deb - cre):.2f}",
        ])
    headers = ["Code","Name","Debit","Credit","Balance"]

    if _is_csv(request):
        xrows.append(["TOTALS","", f"{total_deb:.2f}", f"{total_cre:.2f}", f"{total_bal:.2f}"])
        return rows_to_csv_response(f"trial_balance_{dfrom}_to_{dto}", headers, xrows)
    if _want_xlsx(request):
        xrows.append(["TOTALS","", f"{total_deb:.2f}", f"{total_cre:.2f}", f"{total_bal:.2f}"])
        return rows_to_xlsx_response(f"trial_balance_{dfrom}_to_{dto}", headers, xrows)

    ctx = dict(
        rows=rows, dfrom=dfrom, dto=dto, code_prefix=code_prefix,
        total_deb=total_deb, total_cre=total_cre, total_bal=total_bal, balanced=balanced,
    )
    return render(request, "admin/accounting/reports/trial_balance.html", ctx)


