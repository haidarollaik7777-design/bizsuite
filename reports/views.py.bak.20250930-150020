@staff_member_required


def report_income_statement(request):
    # Minimal IS: Revenue (4xxx) vs Expenses (5xxx). Adjust if your chart differs.
    Posting, cfg = _posting_model_and_fields()
    dfrom, dto = _date_range(request)

    base = Posting.objects.filter(**{
        f"{cfg['date']}__gte": dfrom,
        f"{cfg['date']}__lte": dto,
    })

    rev_q = (base.filter(**{f"{cfg['account']}__code__startswith": "4"})
                  .values("account__code","account__name")
                  .annotate(deb=_coalesce0(cfg["debit"]), cre=_coalesce0(cfg["credit"]))
                  .order_by("account__code"))
    exp_q = (base.filter(**{f"{cfg['account']}__code__startswith": "5"})
                  .values("account__code","account__name")
                  .annotate(deb=_coalesce0(cfg["debit"]), cre=_coalesce0(cfg["credit"]))
                  .order_by("account__code"))

    rev_rows = list(rev_q)
    exp_rows = list(exp_q)

    # amounts
    for r in rev_rows:
        r["amount"] = (r["cre"] or Decimal("0")) - (r["deb"] or Decimal("0"))
    for r in exp_rows:
        r["amount"] = (r["deb"] or Decimal("0")) - (r["cre"] or Decimal("0"))

    total_rev = sum(r["amount"] for r in rev_rows)
    total_exp = sum(r["amount"] for r in exp_rows)
    net_income = total_rev - total_exp

    # export
    if _is_csv(request) or _want_xlsx(request):
        headers = ["Section","Code","Name","Amount"]
        rows = []
        for r in rev_rows:
            rows.append(["Revenue", r["account__code"] or "", r["account__name"] or "", f"{r['amount']:.2f}"])
        rows.append(["","Total Revenue","", f"{total_rev:.2f}"])
        for r in exp_rows:
            rows.append(["Expenses", r["account__code"] or "", r["account__name"] or "", f"{r['amount']:.2f}"])
        rows.append(["","Total Expenses","", f"{total_exp:.2f}"])
        rows.append(["","Net Income","", f"{net_income:.2f}"])

        if _is_csv(request):
            return rows_to_csv_response(f"income_statement_{dfrom}_to_{dto}", headers, rows)
        else:
            return rows_to_xlsx_response(f"income_statement_{dfrom}_to_{dto}", headers, rows)

    ctx = dict(dfrom=dfrom, dto=dto, rev_rows=rev_rows, exp_rows=exp_rows,
               total_rev=total_rev, total_exp=total_exp, net_income=net_income)
    return render(request, "admin/accounting/reports/income_statement.html", ctx)


@staff_member_required


def report_balance_sheet(request):
    # Minimal BS: Assets (1xxx), Liabilities (2xxx), Equity (3xxx)
    Posting, cfg = _posting_model_and_fields()
    dfrom, dto = _date_range(request)

    base = Posting.objects.filter(**{
        f"{cfg['date']}__lte": dto,
    })

    def agg(prefix):
        return (base.filter(**{f"{cfg['account']}__code__startswith": prefix})
                    .values("account__code","account__name")
                    .annotate(deb=_coalesce0(cfg["debit"]), cre=_coalesce0(cfg["credit"]))
                    .order_by("account__code"))

    assets = list(agg("1"))
    liabs  = list(agg("2"))
    equity = list(agg("3"))

    for r in assets: r["amount"] = (r["deb"] or Decimal("0")) - (r["cre"] or Decimal("0"))
    for r in liabs:  r["amount"] = (r["cre"] or Decimal("0")) - (r["deb"] or Decimal("0"))
    for r in equity: r["amount"] = (r["cre"] or Decimal("0")) - (r["deb"] or Decimal("0"))

    total_assets = sum(r["amount"] for r in assets)
    total_liabs  = sum(r["amount"] for r in liabs)
    total_equity = sum(r["amount"] for r in equity)

    # export
    if _is_csv(request) or _want_xlsx(request):
        headers = ["Section","Code","Name","Amount"]
        rows = []
        for r in assets:
            rows.append(["Assets", r["account__code"] or "", r["account__name"] or "", f"{r['amount']:.2f}"])
        rows.append(["","Total Assets","", f"{total_assets:.2f}"])
        for r in liabs:
            rows.append(["Liabilities", r["account__code"] or "", r["account__name"] or "", f"{r['amount']:.2f}"])
        rows.append(["","Total Liabilities","", f"{total_liabs:.2f}"])
        for r in equity:
            rows.append(["Equity", r["account__code"] or "", r["account__name"] or "", f"{r['amount']:.2f}"])
        rows.append(["","Total Equity","", f"{total_equity:.2f}"])

        if _is_csv(request):
            return rows_to_csv_response(f"balance_sheet_as_of_{dto}", headers, rows)
        else:
            return rows_to_xlsx_response(f"balance_sheet_as_of_{dto}", headers, rows)

    ctx = dict(dfrom=dfrom, dto=dto, assets=assets, liabs=liabs, equity=equity,
               total_assets=total_assets, total_liabs=total_liabs, total_equity=total_equity)
    return render(request, "admin/accounting/reports/balance_sheet.html", ctx)
def _get_attr_path(obj, path: str):
    """
    Safely follow an attribute path like "entry__date" or "entry.date"
    on an instance. Returns None if any hop is missing.
    """
    cur = obj
    for part in path.replace("__", ".").split("."):
        if not part:
            continue
        cur = getattr(cur, part, None)
        if cur is None:
            return None
    return cur

from django.shortcuts import redirect
from django.http import Http404

def redirect_rc_slug(request, report_id: str):
    mapping = {
        "trial-balance": "trial-balance",
        "general-ledger": "general-ledger",
        "balance-sheet": "balance-sheet",
        "income-statement": "income-statement",
    }
    slug = mapping.get(report_id)
    if not slug:
        raise Http404("Unknown report")
    new = f"/admin/reports/{slug}/"
    qs = request.META.get("QUERY_STRING")
    if qs:
        new += f"?{qs}"
    return redirect(new)



