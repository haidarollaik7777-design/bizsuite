from decimal import Decimal
from datetime import date
from django.apps import apps as dj_apps
from django.conf import settings
from django.db.models import Sum, Value, DecimalField, F
from django.db.models.functions import Coalesce
from django.shortcuts import render
from django.utils import timezone
from .utils.csv_export import rows_to_csv_response, safe_date
from .utils.xlsx_export import rows_to_xlsx_response

# ---------- helpers ----------

def _is_csv(request):   return (request.GET.get("format") or "").lower() == "csv"
def _want_xlsx(request):return (request.GET.get("format") or "").lower() in ("xlsx","excel")

def _date_range(request):
    today = timezone.now().date()
    dfrom = safe_date(request.GET.get("from"), today.replace(day=1))
    dto   = safe_date(request.GET.get("to"),   today)
    return dfrom, dto

def _cfg():
    cfg = getattr(settings, "REPORTS_POSTING", {})
    model_label = cfg.get("model", "ledger.Posting")
    app_label, model_name = model_label.split(".")
    Model = dj_apps.get_model(app_label, model_name)
    return Model, {
        "date": cfg.get("date", "date"),
        "account": cfg.get("account", "account"),
        "debit": cfg.get("debit", "debit"),
        "credit": cfg.get("credit", "credit"),
        "memo": cfg.get("memo", "memo"),
        "amount": cfg.get("amount"),  # optional single signed amount field
    }

def _dec0():
    return Value(Decimal("0.00"), output_field=DecimalField(max_digits=18, decimal_places=2))

# ---------- Trial Balance ----------

def report_trial_balance(request):
    Model, cfg = _cfg()
    dfrom, dto = _date_range(request)
    code_prefix = (request.GET.get("code_prefix") or "").strip()

    date_f = cfg["date"]; acct_f = cfg["account"]; deb_f = cfg["debit"]; cre_f = cfg["credit"]

    filters = {f"{date_f}__gte": dfrom, f"{date_f}__lte": dto}
    if code_prefix:
        filters[f"{acct_f}__code__startswith"] = code_prefix

    deb_agg = Coalesce(Sum(F(deb_f), output_field=DecimalField(max_digits=18, decimal_places=2)), _dec0())
    cre_agg = Coalesce(Sum(F(cre_f), output_field=DecimalField(max_digits=18, decimal_places=2)), _dec0())

    qs = (Model.objects
          .filter(**filters)
          .values(f"{acct_f}__code", f"{acct_f}__name")
          .annotate(deb=deb_agg, cre=cre_agg)
          .order_by(f"{acct_f}__code"))

    # export rows
    rows = []
    total_deb = Decimal("0.00"); total_cre = Decimal("0.00")
    for r in qs:
        deb = r["deb"] or Decimal("0.00"); cre = r["cre"] or Decimal("0.00")
        total_deb += deb; total_cre += cre
        rows.append([r[f"{acct_f}__code"] or "", r[f"{acct_f}__name"] or "",
                     f"{deb:.2f}", f"{cre:.2f}", f"{(deb-cre):.2f}"])
    headers = ["Code","Name","Debit","Credit","Balance"]

    if _is_csv(request):
        rows.append(["TOTALS","", f"{total_deb:.2f}", f"{total_cre:.2f}", f"{(total_deb-total_cre):.2f}"])
        return rows_to_csv_response(f"trial_balance_{dfrom}_to_{dto}", headers, rows)
    if _want_xlsx(request):
        rows.append(["TOTALS","", f"{total_deb:.2f}", f"{total_cre:.2f}", f"{(total_deb-total_cre):.2f}"])
        return rows_to_xlsx_response(f"trial_balance_{dfrom}_to_{dto}", headers, rows)

    context = {
        "rows": list(qs),
        "dfrom": dfrom, "dto": dto,
        "code_prefix": code_prefix,
        "total_deb": total_deb, "total_cre": total_cre,
        "balanced": abs(total_deb - total_cre) < Decimal("0.005"),
    }
    return render(request, "admin/accounting/reports/trial_balance.html", context)

# ---------- General Ledger ----------

def report_general_ledger(request):
    Model, cfg = _cfg()
    dfrom, dto = _date_range(request)
    code_prefix = (request.GET.get("code_prefix") or "").strip()

    date_f = cfg["date"]; acct_f = cfg["account"]; deb_f = cfg["debit"]; cre_f = cfg["credit"]; memo_f = cfg.get("memo") or "memo"

    filters = {f"{date_f}__gte": dfrom, f"{date_f}__lte": dto}
    if code_prefix:
        filters[f"{acct_f}__code__startswith"] = code_prefix

    qs = (Model.objects
          .select_related(acct_f)
          .filter(**filters)
          .order_by(date_f,"id"))

    # export rows
    rows = []
    for x in qs:
        dt = getattr(x, date_f)
        acct = getattr(x, acct_f, None)
        debit = getattr(x, deb_f, None) or Decimal("0.00")
        credit = getattr(x, cre_f, None) or Decimal("0.00")
        memo = getattr(x, memo_f, None) or ""
        rows.append([dt.isoformat(), getattr(acct,"code",""), getattr(acct,"name",""),
                     f"{Decimal(debit):.2f}", f"{Decimal(credit):.2f}", str(memo)[:500]])
    headers = ["Date","Code","Name","Debit","Credit","Memo"]

    if _is_csv(request):
        return rows_to_csv_response(f"general_ledger_{dfrom}_to_{dto}", headers, rows)
    if _want_xlsx(request):
        return rows_to_xlsx_response(f"general_ledger_{dfrom}_to_{dto}", headers, rows)

    return render(request, "admin/accounting/reports/general_ledger.html",
                  {"lines": qs, "dfrom": dfrom, "dto": dto, "code_prefix": code_prefix})

# ---------- Income Statement (very simple buckets: 4xxx revenue, 5/6xxx expenses) ----------

def report_income_statement(request):
    Model, cfg = _cfg()
    dfrom, dto = _date_range(request)
    date_f = cfg["date"]; acct_f = cfg["account"]; deb_f = cfg["debit"]; cre_f = cfg["credit"]

    filters = {f"{date_f}__gte": dfrom, f"{date_f}__lte": dto}
    qs = (Model.objects.filter(**filters)
          .values(f"{acct_f}__code", f"{acct_f}__name"))

    # signed = credit - debit (typical for P&L with credit revenue, debit expense)
    amt = Coalesce(Sum(F(cre_f), output_field=DecimalField(max_digits=18, decimal_places=2)), _dec0()) \
        - Coalesce(Sum(F(deb_f), output_field=DecimalField(max_digits=18, decimal_places=2)), _dec0())

    per_acct = qs.annotate(amount=amt).order_by(f"{acct_f}__code")

    rev = []; exp = []; total_rev = Decimal("0.00"); total_exp = Decimal("0.00")
    for r in per_acct:
        code = r[f"{acct_f}__code"] or ""
        amt = r["amount"] or Decimal("0.00")
        if code.startswith("4"):  # revenue
            total_rev += amt
            rev.append(r)
        elif code.startswith(("5","6")):  # expenses ranges
            total_exp += -amt  # expenses show positive
            exp.append(r)

    net = total_rev - total_exp

    if _is_csv(request) or _want_xlsx(request):
        rows = [["Section","Code","Name","Amount"]]
        for r in rev:
            rows.append(["Revenue", r[f"{acct_f}__code"], r[f"{acct_f}__name"], f"{(r['amount'] or 0):.2f}"])
        rows.append(["Total Revenue","","", f"{total_rev:.2f}"])
        for r in exp:
            rows.append(["Expenses", r[f"{acct_f}__code"], r[f"{acct_f}__name"], f"{(-(r['amount'] or 0)):.2f}"])
        rows.append(["Total Expenses","","", f"{total_exp:.2f}"])
        rows.append(["Net Income","","", f"{net:.2f}"])
        name = f"income_statement_{dfrom}_to_{dto}"
        if _is_csv(request): return rows_to_csv_response(name, [], rows)
        return rows_to_xlsx_response(name, [], rows)

    ctx = {"dfrom": dfrom, "dto": dto, "revenue": rev, "expenses": exp,
           "total_rev": total_rev, "total_exp": total_exp, "net": net}
    return render(request, "admin/accounting/reports/income_statement.html", ctx)

# ---------- Balance Sheet (simple: 1xxx assets, 2xxx liabilities, 3xxx equity) ----------

def report_balance_sheet(request):
    Model, cfg = _cfg()
    dfrom, dto = _date_range(request)
    date_f = cfg["date"]; acct_f = cfg["account"]; deb_f = cfg["debit"]; cre_f = cfg["credit"]

    filters = {f"{date_f}__lte": dto}
    qs = (Model.objects.filter(**filters)
          .values(f"{acct_f}__code", f"{acct_f}__name"))

    bal = Coalesce(Sum(F(deb_f), output_field=DecimalField(max_digits=18, decimal_places=2)), _dec0()) \
        - Coalesce(Sum(F(cre_f), output_field=DecimalField(max_digits=18, decimal_places=2)), _dec0())

    per_acct = qs.annotate(balance=bal).order_by(f"{acct_f}__code")

    assets=[]; liab=[]; equity=[]
    ta=Decimal("0.00"); tl=Decimal("0.00"); te=Decimal("0.00")
    for r in per_acct:
        code = r[f"{acct_f}__code"] or ""
        b = r["balance"] or Decimal("0.00")
        if code.startswith("1"):
            assets.append(r); ta += b
        elif code.startswith("2"):
            liab.append(r); tl += -b
        elif code.startswith("3"):
            equity.append(r); te += -b
    if _is_csv(request) or _want_xlsx(request):
        rows = [["Section","Code","Name","Amount"]]
        for r in assets: rows.append(["Assets", r[f"{acct_f}__code"], r[f"{acct_f}__name"], f"{r['balance']:.2f}"])
        rows.append(["Total Assets","","", f"{ta:.2f}"])
        for r in liab: rows.append(["Liabilities", r[f"{acct_f}__code"], r[f"{acct_f}__name"], f"{(-r['balance']):.2f}"])
        rows.append(["Total Liabilities","","", f"{tl:.2f}"])
        for r in equity: rows.append(["Equity", r[f"{acct_f}__code"], r[f"{acct_f}__name"], f"{(-r['balance']):.2f}"])
        rows.append(["Total Equity","","", f"{te:.2f}"])
        rows.append(["L = A - E","","", f"{(ta-te):.2f}"])
        name = f"balance_sheet_as_of_{dto}"
        if _is_csv(request): return rows_to_csv_response(name, [], rows)
        return rows_to_xlsx_response(name, [], rows)

    ctx = {"dfrom": dfrom, "dto": dto, "assets": assets, "liabilities": liab, "equity": equity,
           "total_assets": ta, "total_liab": tl, "total_equity": te}
    return render(request, "admin/accounting/reports/balance_sheet.html", ctx)# --- legacy proxy redirect for /admin/rc/<slug>/ ---
from django.urls import reverse
from django.http import Http404, HttpResponseRedirect

def redirect_rc_slug(request, report_id: str):
    slug = str(report_id or "").lower()
    mapping = {
        "trial-balance": "report_trial_balance",
        "general-ledger": "report_general_ledger",
        "balance-sheet": "report_balance_sheet",
        "income-statement": "report_income_statement",
        # legacy aliases
        "trialbalance": "report_trial_balance",
        "generalledger": "report_general_ledger",
        "balancesheet": "report_balance_sheet",
        "incomestatement": "report_income_statement",
        "tb": "report_trial_balance",
        "gl": "report_general_ledger",
        "bs": "report_balance_sheet",
        "is": "report_income_statement",
    }
    name = mapping.get(slug)
    if not name:
        raise Http404("Unknown report")
    url = reverse(name)
    qs = request.META.get("QUERY_STRING")
    if qs:
        url = f"{url}?{qs}"
    return HttpResponseRedirect(url)
