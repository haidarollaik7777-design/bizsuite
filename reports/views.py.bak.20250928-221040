def _get_posting_schema():
    """
    Uses settings.REPORTS_POSTING to resolve the Posting model and its key fields.
    Expected keys (with safe defaults):
      model:   "ledger.Posting"
      date:    "date"
      debit:   "debit"
      credit:  "credit"
      account: "account" (FK to Account model with code/name)
    """
    from django.conf import settings
    from django.apps import apps

    cfg = getattr(settings, "REPORTS_POSTING", {}) or {}
    model_label = cfg.get("model", "ledger.Posting")
    app_label, model_name = model_label.split(".", 1)
    Posting = apps.get_model(app_label, model_name)  # raises LookupError if missing

    date_f   = cfg.get("date",   "date")
    debit_f  = cfg.get("debit",  "debit")
    credit_f = cfg.get("credit", "credit")
    acct_fk  = cfg.get("account","account")

    acct_field = Posting._meta.get_field(acct_fk)
    AccountModel = acct_field.remote_field.model

    # detect code/name fields on Account
    code_field = "code" if "code" in {f.name for f in AccountModel._meta.get_fields()} else None
    name_field = "name" if "name" in {f.name for f in AccountModel._meta.get_fields()} else None

    if not code_field:
        from django.db.models import CharField
        for f in AccountModel._meta.get_fields():
            try:
                if isinstance(f, CharField):
                    code_field = f.name; break
            except Exception:
                pass
    if not name_field:
        for cand in ("title","label","description"):
            if cand in {f.name for f in AccountModel._meta.get_fields()}:
                name_field = cand; break
        if not name_field:
            name_field = code_field  # last resort

    return Posting, date_f, debit_f, credit_f, acct_fk, AccountModel, code_field, name_field

def report_trial_balance(request):
    """
    Trial Balance using REPORTS_POSTING (e.g., ledger.Posting).
    - CSV/XLSX export works.
    - HTML (no ?format) returns a stub in this restore point.
    """
    # If not an export, avoid templates in this restore point
    if not (_is_csv(request) or _want_xlsx(request)):
        return HttpResponse("Trial Balance HTML not implemented in this restore point. Use ?format=csv or ?format=xlsx.", status=501, content_type="text/plain")

    # Resolve schema
    try:
        Posting, date_f, debit_f, credit_f, acct_fk, AccountModel, code_f, name_f = _get_posting_schema()
    except Exception as e:
        return HttpResponse(f"Posting schema error: {e}", status=500, content_type="text/plain")

    # Filters
    dfrom, dto = _date_range(request)
    code_prefix = (request.GET.get("code_prefix") or "").strip()

    q = Posting.objects.select_related(acct_fk).filter(**{f"{date_f}__gte": dfrom, f"{date_f}__lte": dto})
    if code_prefix and code_f:
        q = q.filter(**{f"{acct_fk}__{code_f}__startswith": code_prefix})

    agg = (q.values(f"{acct_fk}_id", f"{acct_fk}__{code_f}", f"{acct_fk}__{name_f}")
             .annotate(deb=Coalesce(Sum(debit_f), Value(0)),
                       cre=Coalesce(Sum(credit_f), Value(0)))
             .order_by(f"{acct_fk}__{code_f}"))

    headers = ["Code","Name","Debit","Credit","Balance"]
    rows = []
    total_deb = total_cre = 0.0
    for r in agg:
        code = str(r.get(f"{acct_fk}__{code_f}", "") or "")
        name = str(r.get(f"{acct_fk}__{name_f}", "") or "")
        deb = float(r["deb"] or 0.0); total_deb += deb
        cre = float(r["cre"] or 0.0); total_cre += cre
        rows.append([code, name, f"{deb:.2f}", f"{cre:.2f}", f"{(deb - cre):.2f}"])

    # add totals row
    rows.append(["TOTALS","", f"{total_deb:.2f}", f"{total_cre:.2f}", f"{(total_deb-total_cre):.2f}"])

    fname = f"trial_balance_{dfrom}_to_{dto}"
    if _is_csv(request):
        return rows_to_csv_response(fname, headers, rows)
    if _want_xlsx(request):
        return rows_to_xlsx_response(fname, headers, rows)
    return HttpResponse("Unsupported request", status=400, content_type="text/plain")
