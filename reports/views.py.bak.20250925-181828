from django.apps import apps
from django.shortcuts import render, redirect
from django.utils import timezone
from django.db.models import Sum, Value
from django.db.models.functions import Coalesce

from .utils.csv_export import rows_to_csv_response, safe_date
from .utils.xlsx_export import rows_to_xlsx_response

# ---------------- Helpers ----------------
def _is_csv(request):
    return (request.GET.get("format") or "").lower() == "csv"

def _want_xlsx(request):
    return (request.GET.get("format") or "").lower() in ("xlsx", "excel")

def _date_range(request):
    """
    Parses ?from=YYYY-MM-DD&to=YYYY-MM-DD; defaults to the current month.
    """
    today = timezone.now().date()
    dfrom = request.GET.get("from")
    dto   = request.GET.get("to")
    if not dfrom or not dto:
        import calendar
        dfrom = today.replace(day=1)
        last_day = calendar.monthrange(today.year, today.month)[1]
        dto = today.replace(day=last_day)
    else:
        dfrom = safe_date(dfrom, today.replace(day=1))
        dto   = safe_date(dto, today)
    return dfrom, dto

# -------------- (Optional) admin proxy helper --------------
def report_center_proxy(request, report_id: str):
    """
    Proxy from admin/ledger/reportcenterproxy/<report_id>/ to our real report URLs.
    Preserves the query string (?from=&to=&code_prefix=...).
    """
    mapping = {
        "general-ledger": "/admin/reports/general-ledger/",
        "trial-balance": "/admin/reports/trial-balance/",
        # Add others if/when implemented:
        "balance-sheet": "/admin/reports/balance-sheet/",
        "income-statement": "/admin/reports/income-statement/",
    }
    target = mapping.get(report_id, "/admin/reports/")
    qs = request.META.get("QUERY_STRING", "")
    if qs:
        target = f"{target}?{qs}"
    return redirect(target)

# ---------------- General Ledger ----------------
def report_general_ledger(request):
    JournalLine = apps.get_model("accounting", "JournalLine")

    dfrom, dto = _date_range(request)
    account_id  = request.GET.get("account")  # optional exact account id
    code_prefix = (request.GET.get("code_prefix") or "").strip()

    q = (JournalLine.objects
         .select_related("entry","account")
         .filter(entry__is_posted=True, entry__date__gte=dfrom, entry__date__lte=dto))

    if account_id:
        q = q.filter(account_id=account_id)
    if code_prefix:
        q = q.filter(account__code__startswith=code_prefix)

    q = q.order_by("entry__date", "entry_id", "id").distinct()

    # Export rows
    headers = ["Date", "Code", "Name", "Debit", "Credit", "Memo"]
    rows = []
    for ln in q:
        rows.append([
            ln.entry.date.isoformat(),
            getattr(ln.account, "code", ""),
            getattr(ln.account, "name", ""),
            f"{float(ln.debit or 0):.2f}",
            f"{float(ln.credit or 0):.2f}",
            (ln.memo or ln.entry.memo or "")[:500],
        ])

    if _is_csv(request):
        return rows_to_csv_response(f"general_ledger_{dfrom}_to_{dto}", headers, rows)
    if _want_xlsx(request):
        return rows_to_xlsx_response(f"general_ledger_{dfrom}_to_{dto}", headers, rows)

    context = {
        "lines": q,
        "dfrom": dfrom,
        "dto": dto,
        "account_id": account_id,
        "code_prefix": code_prefix,
    }
    return render(request, "admin/accounting/reports/general_ledger.html", context)

# ---------------- Trial Balance ----------------
def report_trial_balance(request):
    JournalLine = apps.get_model("accounting", "JournalLine")

    dfrom, dto = _date_range(request)
    code_prefix = (request.GET.get("code_prefix") or "").strip()

    base = JournalLine.objects.filter(
        entry__is_posted=True, entry__date__gte=dfrom, entry__date__lte=dto
    )
    if code_prefix:
        base = base.filter(account__code__startswith=code_prefix)

    # Aggregate per account
    period = (base.values("account_id", "account__code", "account__name")
              .annotate(deb=Coalesce(Sum("debit"), Value(0)),
                        cre=Coalesce(Sum("credit"), Value(0)))
              .order_by("account__code"))

    # Prepare display & export rows
    rows_display = []
    rows_export  = []
    total_deb = 0.0
    total_cre = 0.0

    for r in period:
        deb = float(r["deb"] or 0.0)
        cre = float(r["cre"] or 0.0)
        bal = deb - cre
        total_deb += deb
        total_cre += cre
        rows_display.append({
            "account__code": r["account__code"] or "",
            "account__name": r["account__name"] or "",
            "deb": deb,
            "cre": cre,
            "balance": bal,
        })
        rows_export.append([
            r["account__code"] or "",
            r["account__name"] or "",
            f"{deb:.2f}",
            f"{cre:.2f}",
            f"{bal:.2f}",
        ])

    headers = ["Code", "Name", "Debit", "Credit", "Balance"]
    total_net = total_deb - total_cre
    balanced = abs(total_net) < 0.005

    if _is_csv(request):
        rows_export.append(["TOTALS", "", f"{total_deb:.2f}", f"{total_cre:.2f}", f"{total_net:.2f}"])
        return rows_to_csv_response(f"trial_balance_{dfrom}_to_{dto}", headers, rows_export)

    if _want_xlsx(request):
        rows_export.append(["TOTALS", "", f"{total_deb:.2f}", f"{total_cre:.2f}", f"{total_net:.2f}"])
        return rows_to_xlsx_response(f"trial_balance_{dfrom}_to_{dto}", headers, rows_export)

    context = {
        "rows": rows_display,
        "dfrom": dfrom, "dto": dto,
        "code_prefix": code_prefix,
        "total_deb": total_deb, "total_cre": total_cre,
        "total_net": total_net, "balanced": balanced,
    }
    return render(request, "admin/accounting/reports/trial_balance.html", context)