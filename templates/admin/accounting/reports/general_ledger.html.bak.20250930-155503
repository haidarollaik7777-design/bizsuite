{% extends "admin/base_site.html" %}
{% block content %}
<h1>General Ledger</h1>
<form method="get" style="display:flex;gap:8px;align-items:end;margin:10px 0;">
  <div><label>From</label><input type="date" name="from" value="{{ dfrom|date:'Y-m-d' }}"></div>
  <div><label>To</label><input type="date" name="to" value="{{ dto|date:'Y-m-d' }}"></div>
  <div><label>Account code (prefix)</label><input name="code_prefix" value="{{ code_prefix }}"></div>
  <div style="display:flex;gap:6px;">
    <button type="submit">Apply</button>
    <a class="button" href="{{ request.path }}">Clear</a>
    <a class="button" href="?from={{ dfrom }}&to={{ dto }}{% if code_prefix %}&code_prefix={{ code_prefix }}{% endif %}&format=csv">Export CSV</a>
    <a class="button" href="?from={{ dfrom }}&to={{ dto }}{% if code_prefix %}&code_prefix={{ code_prefix }}{% endif %}&format=xlsx">Export XLSX</a>
  </div>
</form>

<table style="width:100%;border-collapse:collapse;">
  <thead><tr>
    <th>Date</th><th>Code</th><th>Name</th><th style="text-align:right;">Debit</th><th style="text-align:right;">Credit</th><th>Memo</th>
  </tr></thead>
  <tbody>
    {% for ln in lines %}
      <tr>
        <td>{{ ln|dget:"entry__date"|date:"Y-m-d" }}</td>
        <td>{{ ln.account.code }}</td>
        <td>{{ ln.account.name }}</td>
        <td style="text-align:right;">{{ ln.debit|floatformat:2 }}</td>
        <td style="text-align:right;">{{ ln.credit|floatformat:2 }}</td>
        <td>{{ ln.memo }}</td>
      </tr>
    {% empty %}
      <tr><td colspan="6">No rows.</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}



