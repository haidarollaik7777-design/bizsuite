{% extends "admin/base_site.html" %}
{% block content %}
<h1>General Ledger</h1>
<form method="get" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; margin:12px 0;">
  <div><label>From</label><input type="date" name="from" value="{{ dfrom|date:'Y-m-d' }}"></div>
  <div><label>To</label><input type="date" name="to" value="{{ dto|date:'Y-m-d' }}"></div>
  <div><label>Account code (prefix)</label><input name="code_prefix" value="{{ code_prefix }}" placeholder="e.g. 1200"></div>
  <div style="display:flex; gap:8px;">
    <button type="submit">Apply</button>
    <a class="button" href="{{ request.path }}">Clear</a>
    <a class="button" href="?from={{ dfrom }}&to={{ dto }}{% if code_prefix %}&code_prefix={{ code_prefix }}{% endif %}&format=csv">Export CSV</a>
    <a class="button" href="?from={{ dfrom }}&to={{ dto }}{% if code_prefix %}&code_prefix={{ code_prefix }}{% endif %}&format=xlsx">Export XLSX</a>
  </div>
</form>

<table style="width:100%; border-collapse:collapse;">
  <thead><tr>
    <th style="text-align:left; padding:6px;">Date</th>
    <th style="text-align:left; padding:6px;">Code</th>
    <th style="text-align:left; padding:6px;">Name</th>
    <th style="text-align:right; padding:6px;">Debit</th>
    <th style="text-align:right; padding:6px;">Credit</th>
    <th style="text-align:left; padding:6px;">Memo</th>
  </tr></thead>
  <tbody>
    {% for ln in lines %}
      <tr>
        <td style="padding:6px;">{{ ln.date|date:"Y-m-d" }}</td>
        <td style="padding:6px;">{{ ln.account.code }}</td>
        <td style="padding:6px;">{{ ln.account.name }}</td>
        <td style="text-align:right; padding:6px;">{{ ln.debit|floatformat:2 }}</td>
        <td style="text-align:right; padding:6px;">{{ ln.credit|floatformat:2 }}</td>
        <td style="padding:6px;">{{ ln.memo }}</td>
      </tr>
    {% empty %}
      <tr><td colspan="6" style="padding:6px;">No rows.</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}