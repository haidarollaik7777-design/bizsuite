{% extends "admin/base_site.html" %}
{% block content %}
<h1>{{ title }}</h1>
<form method="get" class="module" style="padding:10px;margin-bottom:12px;">
  <div style="display:flex;gap:12px;flex-wrap:wrap;">
    {{ form.company.label_tag }} {{ form.company }}
    {{ form.account.label_tag }} {{ form.account }}
    {{ form.date_from.label_tag }} {{ form.date_from }}
    {{ form.date_to.label_tag }} {{ form.date_to }}
    <button class="button" type="submit">Apply</button>
    <a class="button" href="?{% if form.company.value %}company={{ form.company.value }}&{% endif %}{% if form.account.value %}account={{ form.account.value }}&{% endif %}{% if form.date_from.value %}date_from={{ form.date_from.value }}&{% endif %}{% if form.date_to.value %}date_to={{ form.date_to.value }}&{% endif %}export=csv">Export CSV</a> <a class="button" href="/admin/ledger/reportcenterproxy/general-ledger/?format=xlsx">Export XLSX (new)</a>
  </div>
</form>

<table class="listing">
  <thead>
    <tr><th>Date</th><th>Account</th><th>Reference</th><th>Description</th><th style="text-align:right;">Debit</th><th style="text-align:right;">Credit</th><th style="text-align:right;">Running</th></tr>
  </thead>
  <tbody>
  {% for e, bal in rows %}
    <tr>
      <td>{{ e.date }}</td>
      <td>{{ e.account }}</td>
      <td>{{ e.reference }}</td>
      <td>{{ e.description }}</td>
      <td style="text-align:right;">{{ e.debit|floatformat:2 }}</td>
      <td style="text-align:right;">{{ e.credit|floatformat:2 }}</td>
      <td style="text-align:right;">{{ bal|floatformat:2 }}</td>
    </tr>
  {% empty %}
    <tr><td colspan="7">No entries.</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}

