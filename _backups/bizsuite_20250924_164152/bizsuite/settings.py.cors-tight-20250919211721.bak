# --- CORS (auto-appended for dev) ---
try:
    # Make sure the arrays exist and are mutable
    INSTALLED_APPS = list(INSTALLED_APPS)
    MIDDLEWARE = list(MIDDLEWARE)

    if 'corsheaders' not in INSTALLED_APPS:
        INSTALLED_APPS.append('corsheaders')

    cmw = 'corsheaders.middleware.CorsMiddleware'
    if cmw not in MIDDLEWARE:
        # Put it first as recommended by the package docs
        MIDDLEWARE = [cmw] + MIDDLEWARE

    # DEV: allow all origins so your front-end Just Works
    CORS_ALLOW_ALL_ORIGINS = True

    # If you want strict origins later, comment the line above and use:
    # CORS_ALLOW_ALL_ORIGINS = False
